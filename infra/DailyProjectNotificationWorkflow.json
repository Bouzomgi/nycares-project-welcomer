{
  "Comment": "Project Notifier Step Functions Workflow (Single Message, Auth Passed, DLQ Handling)",
  "StartAt": "Login",
  "States": {
    "Login": {
      "Type": "Task",
      "Resource": "${LoginLambdaArn}",
      "Parameters": {
        "executionId.$": "$$.Execution.Id",
        "context.$": "$$.Execution.Input"
      },
      "ResultPath": "$",
      "Next": "FetchProjects",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "IntervalSeconds": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "LoginFailed"
        }
      ]
    },
    "LoginFailed": {
      "Type": "Pass",
      "Parameters": {
        "Error.$": "$.Error",
        "Cause.$": "$.Cause",
        "FailedStep": "Login"
      },
      "Next": "DLQNotifier"
    },
    "FetchProjects": {
      "Type": "Task",
      "Resource": "${FetchProjectsLambdaArn}",
      "InputPath": "$",
      "ResultPath": "$.projects",
      "Next": "ProcessEachProject",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "IntervalSeconds": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FetchProjectsFailed"
        }
      ]
    },
    "FetchProjectsFailed": {
      "Type": "Pass",
      "Parameters": {
        "Error.$": "$.Error",
        "Cause.$": "$.Cause",
        "FailedStep": "FetchProjects"
      },
      "Next": "DLQNotifier"
    },
    "ProcessEachProject": {
      "Type": "Map",
      "ItemsPath": "$.projects.projects",
      "Parameters": {
        "project.$": "$$.Map.Item.Value",
        "auth.$": "$.auth",
        "executionId.$": "$.executionId"
      },
      "Iterator": {
        "StartAt": "RouteProject",
        "States": {
          "RouteProject": {
            "Type": "Task",
            "Resource": "${RouteProjectLambdaArn}",
            "InputPath": "$",
            "ResultPath": "$",
            "Next": "BranchByMessageType",
            "Catch": [
              {
                "ErrorEquals": ["NotTeamLeader", "ProjectCancelled", "ProjectTooFar", "AllNotificationsSent", "NotificationsDisabled"],
                "Next": "EndProjectIteration"
              },
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "RouteProjectFailed"
              }
            ]
          },
          "RouteProjectFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "RouteProject"
            },
            "Next": "ProjectDLQNotifier"
          },
          "BranchByMessageType": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.messageType",
                "StringEquals": "thankYou",
                "Next": "GenerateThankYouMessage"
              }
            ],
            "Default": "ComputePreProjectMessage"
          },
          "GenerateThankYouMessage": {
            "Type": "Task",
            "Resource": "${GenerateThankYouMessageLambdaArn}",
            "InputPath": "$",
            "ResultPath": "$",
            "Next": "ScheduleThankYou",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "GenerateThankYouMessageFailed"
              }
            ]
          },
          "GenerateThankYouMessageFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "GenerateThankYouMessage"
            },
            "Next": "ProjectDLQNotifier"
          },
          "ComputePreProjectMessage": {
            "Type": "Task",
            "Resource": "${ComputePreProjectMessageLambdaArn}",
            "InputPath": "$",
            "ResultPath": "$",
            "Next": "ScheduleThankYou",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "ComputePreProjectMessageFailed"
              }
            ]
          },
          "ScheduleThankYou": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.message.type",
                "StringEquals": "thankYou",
                "Next": "WaitForThankYouWindow"
              }
            ],
            "Default": "RequestApprovalToSend"
          },
          "WaitForThankYouWindow": {
            "Type": "Wait",
            "TimestampPath": "$.targetSendTime",
            "Next": "RequestApprovalToSend"
          },
          "ComputePreProjectMessageFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "ComputePreProjectMessage"
            },
            "Next": "ProjectDLQNotifier"
          },
          "RequestApprovalToSend": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
            "TimeoutSeconds": 86400,
            "Comment": "86400 seconds = 24 hours approval window",
            "Parameters": {
              "FunctionName": "${RequestApprovalToSendLambdaArn}",
              "Payload": {
                "taskToken.$": "$$.Task.Token",
                "auth.$": "$.auth",
                "existingProjectNotification.$": "$.existingProjectNotification",
                "message.$": "$.message",
                "executionId.$": "$.executionId"
              }
            },
            "ResultPath": "$.approvalResult",
            "Next": "CheckApprovalDecision",
            "Catch": [
              {
                "ErrorEquals": ["States.TaskStateTimeout"],
                "Next": "ApprovalTimedOut"
              },
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "RequestApprovalToSendFailed"
              }
            ]
          },
          "CheckApprovalDecision": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.approvalResult.action",
                "StringEquals": "approve",
                "Next": "SendAndPinMessage"
              },
              {
                "Variable": "$.approvalResult.action",
                "StringEquals": "reject",
                "Next": "EndProjectIteration"
              },
              {
                "Variable": "$.approvalResult.action",
                "StringEquals": "manual",
                "Next": "UseManualMessage"
              }
            ],
            "Default": "RegenerateThankYouMessage"
          },
          "UseManualMessage": {
            "Type": "Pass",
            "Parameters": {
              "auth.$": "$.auth",
              "existingProjectNotification.$": "$.existingProjectNotification",
              "message": {
                "type.$": "$.message.type",
                "templateRef.$": "$.message.templateRef",
                "generatedContent.$": "$.approvalResult.manualMessage"
              },
              "executionId.$": "$.executionId"
            },
            "Next": "SendAndPinMessage"
          },
          "RegenerateThankYouMessage": {
            "Type": "Task",
            "Resource": "${GenerateThankYouMessageLambdaArn}",
            "Parameters": {
              "auth.$": "$.auth",
              "existingProjectNotification.$": "$.existingProjectNotification",
              "messageType": "thankYou",
              "targetSendTime.$": "$.targetSendTime",
              "executionId.$": "$.executionId",
              "refinementContext.$": "$.approvalResult.refinementContext"
            },
            "ResultPath": "$",
            "Next": "RequestApprovalToSend",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "RegenerateThankYouMessageFailed"
              }
            ]
          },
          "RegenerateThankYouMessageFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "RegenerateThankYouMessage"
            },
            "Next": "ProjectDLQNotifier"
          },
          "RequestApprovalToSendFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "RequestApprovalToSend"
            },
            "Next": "ProjectDLQNotifier"
          },
          "ApprovalTimedOut": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "RequestApprovalToSend (approval timed out — no response within 24 hours)"
            },
            "Next": "ProjectDLQNotifier"
          },
          "SendAndPinMessage": {
            "Type": "Task",
            "Resource": "${SendAndPinMessageLambdaArn}",
            "InputPath": "$",
            "ResultPath": "$",
            "Next": "RecordMessage",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "SendAndPinMessageFailed"
              }
            ]
          },
          "SendAndPinMessageFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "SendAndPinMessage"
            },
            "Next": "ProjectDLQNotifier"
          },
          "RecordMessage": {
            "Type": "Task",
            "Resource": "${RecordMessageLambdaArn}",
            "InputPath": "$",
            "ResultPath": "$",
            "Next": "NotifyCompletion",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "RecordMessageFailed"
              }
            ]
          },
          "RecordMessageFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "RecordMessage"
            },
            "Next": "ProjectDLQNotifier"
          },
          "NotifyCompletion": {
            "Type": "Task",
            "Resource": "${NotifyCompletionLambdaArn}",
            "InputPath": "$",
            "End": true,
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "NotifyCompletionFailed"
              }
            ]
          },
          "NotifyCompletionFailed": {
            "Type": "Pass",
            "Parameters": {
              "Error.$": "$.Error",
              "Cause.$": "$.Cause",
              "FailedStep": "NotifyCompletion"
            },
            "Next": "ProjectDLQNotifier"
          },
          "ProjectDLQNotifier": {
            "Type": "Task",
            "Resource": "${DLQNotifierLambdaArn}",
            "InputPath": "$",
            "Retry": [
              {
                "ErrorEquals": ["States.ALL"],
                "MaxAttempts": 2,
                "IntervalSeconds": 5,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "ProjectDLQNotifierFailed"
              }
            ],
            "Next": "ProjectWorkflowFailed"
          },
          "ProjectWorkflowFailed": {
            "Type": "Fail",
            "Error": "ProjectWorkflowFailed",
            "Cause": "A project workflow step failed and was reported to the DLQ notifier"
          },
          "ProjectDLQNotifierFailed": {
            "Type": "Fail",
            "Error": "DLQNotifierFailed",
            "Cause": "DLQNotifier failed to report the error after retries"
          },
          "EndProjectIteration": {
            "Type": "Pass",
            "End": true
          }
        }
      },
      "Next": "EndWorkflow"
    },
    "EndWorkflow": {
      "Type": "Pass",
      "End": true
    },
    "DLQNotifier": {
      "Type": "Task",
      "Resource": "${DLQNotifierLambdaArn}",
      "InputPath": "$",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "MaxAttempts": 2,
          "IntervalSeconds": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "DLQNotifierFailed"
        }
      ],
      "Next": "WorkflowFailed"
    },
    "WorkflowFailed": {
      "Type": "Fail",
      "Error": "WorkflowFailed",
      "Cause": "A workflow step failed and was reported to the DLQ notifier"
    },
    "DLQNotifierFailed": {
      "Type": "Fail",
      "Error": "DLQNotifierFailed",
      "Cause": "DLQNotifier failed to report the error after retries"
    }
  }
}
